# docker compose 环境变量示例：复制为 setup/.env 后修改
# setup/.env 已被 .gitignore 忽略，不会被提交。

# MySQL root 口令
MYSQL_ROOT_PASSWORD=CHANGEME

# Redis 口令
REDIS_PASSWORD=CHANGEME

# RabbitMQ 账号（需与 Nacos 配置中的 spring.rabbitmq.* 一致）
RABBITMQ_USER=aurora
RABBITMQ_PASSWORD=CHANGEME

# MinIO 账号（需与 Nacos 配置中的 upload.minio.* 一致）
MINIO_ROOT_USER=aurora
MINIO_ROOT_PASSWORD=CHANGEME

# Nacos 3 鉴权（三者缺一不可，否则容器启动即失败并无限重启）
#
# NACOS_AUTH_TOKEN：JWT 签名密钥，必须是 Base64 字符串，且**解码后 ≥ 32 字节**。
#   生成：openssl rand -base64 32
#   校验：echo -n '<token>' | base64 -d | wc -c    # 结果必须 ≥ 32
#   常见错误：长度不足时报 "the length of secret key must great than or equal 32 bytes"
#   （如 16 字节的随机串解码只有 ~23 字节，会启动失败；不要手敲或复用短口令）
#   Base64 里出现 + / = 是正常的，直接粘贴；.env 中无需加引号。
# 集群部署时所有节点必须用同一个 token。
NACOS_AUTH_TOKEN=CHANGEME_BASE64_32_BYTES
# 服务端节点间身份标识（自定义一对字符串，集群内一致即可）
#   生成：openssl rand -hex 16
NACOS_AUTH_IDENTITY_KEY=CHANGEME_KEY
NACOS_AUTH_IDENTITY_VALUE=CHANGEME_VALUE

# Nacos 登录账号（首次启动后到控制台修改）
NACOS_USER=nacos
NACOS_PASSWORD=CHANGEME
